POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=avito_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
MAX_CONNECTIONS=10
PORT=8080
COURIER_PORT=8082
MAX_ATTEMPTS=10
DELAY=3
PERIOD_CHECK=20
BATCH_SIZE=3
CACHE_TTL=60
CACHE_SIZE=1
ORDER_SERVICE_HOST=service-order:50051
POLLING_PERIOD=3
RETRY_CONNECT_TO_ORDER_SERVICE=10
CONNECT_DELAY=2
KAFKA_PORT=9092
KAFKA_UI_PORT=5050
KAFKA_TOPIC=order.status.changed
IP_TTL=10
MAX_TOKENS=1
REFILL_RATE=1
PROFILE_PORT=6060
RETRY_DELAY=100